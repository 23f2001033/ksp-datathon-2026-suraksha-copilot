# Copy to .env for local development. On Zoho Catalyst, set these as
# Environment Variables in the Catalyst console (Settings > Environment Variables).

# Anthropic API key — get one from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Model the app uses for intent classification, SQL generation, and answer
# composition. Default is Opus 4.8 (highest reliability for the reliability-
# critical text-to-SQL path). Switch to claude-sonnet-5 to cut cost per query.
SURAKSHA_MODEL=claude-opus-4-8

# Number of candidate SQL queries generated in Tier 2 for execution-consensus
# voting. Higher = more reliable, slower, more tokens. 3 is a good default.
SURAKSHA_CONSENSUS_N=3

# Local dev server port (ignored on Catalyst).
PORT=3000
